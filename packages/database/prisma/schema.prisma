// ============================================================================
// اسکیمای دیتابیس - وب‌سایت اختصاصی نمایندگی بیمه ایران (حمایتگر - کد ۹۹۶۸)
// این پروژه ERP / CRM بزرگ / سیستم مالی / سیستم صدور آنلاین نیست.
// فقط مدل‌های لازم برای معرفی خدمات، ثبت درخواست مشاوره و مدیریت محتوا.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// احراز هویت مدیر / نقش‌ها و مجوزها (زیرساخت برای بسته ۳)
// ----------------------------------------------------------------------------

model Role {
  id          String      @id @default(cuid())
  name        String      @unique // مثلاً: SUPER_ADMIN, ADMIN, EDITOR, SUPPORT
  label       String // نام نمایشی فارسی: مدیر کل، ادمین، ویراستار محتوا، پشتیبانی درخواست‌ها
  permissions Json // آرایه‌ای از کلیدهای مجوز، مثل ["requests.manage", "articles.write"]
  adminUsers  AdminUser[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("roles")
}

model AdminUser {
  id                    String                @id @default(cuid())
  fullName              String
  email                 String                @unique
  mobile                String?               @unique
  passwordHash          String
  roleId                String
  role                  Role                  @relation(fields: [roleId], references: [id])
  avatarUrl             String?
  isActive              Boolean               @default(true)
  lastLoginAt           DateTime?
  resetPasswordToken    String?               @unique
  resetPasswordExpiresAt DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  assignedRequests      ConsultationRequest[] @relation("AssignedAdmin")
  requestNotes          RequestNote[]
  customerInteractions  CustomerInteraction[]
  authoredArticles      Article[]
  uploadedMedia         MediaFile[]

  @@map("admin_users")
}

// ----------------------------------------------------------------------------
// تنظیمات سایت (تک‌رکوردی)
// ----------------------------------------------------------------------------

model SiteSetting {
  id                   String   @id @default(cuid())
  siteName             String   @default("حمایتگر")
  siteTagline          String?  @default("نمایندگی رسمی بیمه ایران")
  agencyManager        String   @default("ملیحه علوی")
  agencyCode           String   @default("9968")
  logoUrl              String?
  faviconUrl           String?
  phone                String?
  mobile                String?
  email                String?
  address              String?
  workingHours         String?
  instagramUrl         String?
  telegramUrl          String?
  whatsappUrl          String?
  baleUrl              String?
  rubikaUrl            String?
  defaultSeoTitle      String?
  defaultSeoDescription String?
  googleAnalyticsId    String?
  googleSearchConsole  String?
  // --- تم زنده (قابل تغییر بدون دیپلوی مجدد) ---
  primaryColorHex      String   @default("#1F4573") // پایه پالت سرمه‌ای
  accentColorHex       String   @default("#F5720F") // پایه پالت نارنجی
  borderRadiusStyle    String   @default("rounded") // sharp | rounded | pill
  fontFamily           String   @default("vazirmatn") // vazirmatn | noto
  // --- تصاویر سراسری سایت ---
  heroImageUrl         String?
  heroSecondaryImageUrl String?
  // --- آمار صفحه درباره ما (متن آزاد تا هر فرمتی مثل +۵۰۰۰ هم قابل ثبت باشد) ---
  statSatisfiedCustomers String? @default("+5,000")
  statPoliciesIssued     String? @default("+10,000")
  statYearsExperience    String? @default("+15")
  updatedAt            DateTime @updatedAt

  @@map("site_settings")
}

// ----------------------------------------------------------------------------
// مدیریت صفحات ثابت (درباره ما، تماس با ما، همکاری با ما و ...)
// ----------------------------------------------------------------------------

enum ContentStatus {
  DRAFT
  PUBLISHED
}

model Page {
  id              String        @id @default(cuid())
  slug            String        @unique // about-us, contact-us, cooperation, ...
  title           String
  content         String // HTML/Markdown محتوای صفحه
  status          ContentStatus @default(DRAFT)
  seoTitle        String?
  seoDescription  String?
  ogImageUrl      String?
  faqs            FaqItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("pages")
}

// ----------------------------------------------------------------------------
// اسلایدر صفحه اصلی
// ----------------------------------------------------------------------------

model SliderItem {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String
  linkUrl   String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("slider_items")
}

// ----------------------------------------------------------------------------
// مدیریت تصاویر (کتابخانه رسانه)
// ----------------------------------------------------------------------------

model MediaFile {
  id           String    @id @default(cuid())
  url          String
  altText      String?
  width        Int?
  height       Int?
  sizeInBytes  Int?
  uploadedById String?
  uploadedBy   AdminUser? @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime  @default(now())

  @@map("media_files")
}

// ----------------------------------------------------------------------------
// وبلاگ
// ----------------------------------------------------------------------------

model ArticleCategory {
  id        String    @id @default(cuid())
  slug      String    @unique
  title     String
  articles  Article[]
  createdAt DateTime  @default(now())

  @@map("article_categories")
}

model Article {
  id              String          @id @default(cuid())
  slug            String          @unique
  title           String
  excerpt         String?
  content         String
  coverImageUrl   String?
  status          ContentStatus   @default(DRAFT)
  categoryId      String?
  category        ArticleCategory? @relation(fields: [categoryId], references: [id])
  authorId        String?
  author          AdminUser?      @relation(fields: [authorId], references: [id])
  seoTitle        String?
  seoDescription  String?
  publishedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status, publishedAt])
  @@map("articles")
}

// ----------------------------------------------------------------------------
// سوالات متداول (قابل اتصال به صفحه ثابت، رشته بیمه، زیررشته، یا عمومی)
// ----------------------------------------------------------------------------

model FaqItem {
  id                    String                @id @default(cuid())
  question              String
  answer                String
  order                 Int                   @default(0)
  isGlobal              Boolean               @default(false) // برای صفحه سوالات متداول عمومی
  pageId                String?
  page                  Page?                 @relation(fields: [pageId], references: [id])
  insuranceCategoryId   String?
  insuranceCategory     InsuranceCategory?    @relation(fields: [insuranceCategoryId], references: [id])
  insuranceSubsectionId String?
  insuranceSubsection   InsuranceSubsection?  @relation(fields: [insuranceSubsectionId], references: [id])
  createdAt             DateTime              @default(now())

  @@map("faq_items")
}

// ----------------------------------------------------------------------------
// رشته‌های بیمه (هر رشته = یک صفحه جامع با سکشن‌های زیررشته داخل همان صفحه)
// ----------------------------------------------------------------------------

model InsuranceCategory {
  id               String                @id @default(cuid())
  slug             String                @unique // car, liability, fire, life, engineering, transport, energy
  title            String // بیمه خودرو، بیمه مسئولیت، ...
  shortDescription String?
  icon             String?
  heroImageUrl     String?
  order            Int                   @default(0)
  isActive         Boolean               @default(true)
  seoTitle         String?
  seoDescription   String?
  subsections      InsuranceSubsection[]
  faqs             FaqItem[]
  requests         ConsultationRequest[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([isActive, order])
  @@map("insurance_categories")
}

// زیررشته‌ها به‌صورت پیش‌فرض سکشن مستقل داخل صفحه اصلی رشته هستند،
// نه صفحه جدا؛ فقط با isStandalonePage=true می‌توانند صفحه اختصاصی بگیرند.
model InsuranceSubsection {
  id                 String             @id @default(cuid())
  categoryId         String
  category           InsuranceCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  slug               String // employer, doctors, engineers, ... (در محدوده همان رشته یکتا)
  title              String // مسئولیت کارفرما، مسئولیت پزشکان، ...
  order              Int                @default(0)
  introduction       String // معرفی
  coverages          String // پوشش‌ها
  exclusions         String // موارد استثناء
  benefits           String // مزایا
  imageUrl           String? // تصویر کارت/هیرو این زیررشته (با دستیار هوش مصنوعی قابل تنظیم)
  isStandalonePage   Boolean            @default(false)
  isActive           Boolean            @default(true)
  faqs               FaqItem[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([categoryId, slug])
  @@map("insurance_subsections")
}

// ----------------------------------------------------------------------------
// بلاک‌های محتوایی صفحه — امکان افزودن/حذف/جابه‌جایی سکشن به هر صفحه بدون نیاز
// به تغییر کد. هر بلاک با pageSlug مشخص می‌شود ("home" برای صفحه اصلی، یا slug
// یک صفحه ثابت مثل about-us).
// ----------------------------------------------------------------------------

enum PageSectionType {
  HERO
  TEXT_IMAGE
  FEATURE_GRID
  TESTIMONIALS
  CTA_BANNER
  IMAGE_GALLERY
  CUSTOM_HTML
}

model PageSection {
  id        String          @id @default(cuid())
  pageSlug  String
  type      PageSectionType
  content   Json // ساختار متغیر بسته به نوع بلاک (عنوان، متن، تصاویر و ...)
  order     Int             @default(0)
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([pageSlug, order])
  @@map("page_sections")
}

// ----------------------------------------------------------------------------
// اعلان‌های پنل مدیریت (مثلاً درخواست مشاوره جدید)
// ----------------------------------------------------------------------------

enum NotificationType {
  NEW_REQUEST
  SYSTEM
}

model Notification {
  id                 String            @id @default(cuid())
  type               NotificationType  @default(NEW_REQUEST)
  message            String
  isRead             Boolean           @default(false)
  relatedRequestId   String?
  createdAt          DateTime          @default(now())

  @@index([isRead])
  @@map("notifications")
}

// ----------------------------------------------------------------------------
// درخواست‌های مشاوره (فرم عمومی سایت)
// ----------------------------------------------------------------------------

enum RequestStatus {
  NEW // جدید
  IN_PROGRESS // در حال پیگیری
  CONTACTED // تماس گرفته شده
  CONVERTED // تبدیل به مشتری
  CLOSED // بسته‌شده / بدون نتیجه
}

model ConsultationRequest {
  id                  String              @id @default(cuid())
  fullName            String
  mobile              String
  insuranceCategoryId String?
  insuranceCategory   InsuranceCategory?  @relation(fields: [insuranceCategoryId], references: [id])
  description         String?
  status              RequestStatus       @default(NEW)
  assignedToId        String?
  assignedTo          AdminUser?          @relation("AssignedAdmin", fields: [assignedToId], references: [id])
  customerId          String?
  customer            Customer?           @relation(fields: [customerId], references: [id])
  notes               RequestNote[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([status])
  @@map("consultation_requests")
}

// یادداشت داخلی تیم روی هر درخواست
model RequestNote {
  id           String               @id @default(cuid())
  requestId    String
  request      ConsultationRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  adminUserId  String
  adminUser    AdminUser            @relation(fields: [adminUserId], references: [id])
  note         String
  createdAt    DateTime             @default(now())

  @@map("request_notes")
}

// ----------------------------------------------------------------------------
// مشتریان (پس از تبدیل‌شدن درخواست به مشتری واقعی)
// ----------------------------------------------------------------------------

model Customer {
  id           String                 @id @default(cuid())
  fullName     String
  mobile       String                 @unique
  email        String?
  notes        String?
  requests     ConsultationRequest[]
  interactions CustomerInteraction[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@map("customers")
}

enum InteractionType {
  CALL
  MEETING
  WHATSAPP
  NOTE
  OTHER
}

// سوابق ارتباط با مشتری
model CustomerInteraction {
  id           String           @id @default(cuid())
  customerId   String
  customer     Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type         InteractionType
  description  String
  createdById  String?
  createdBy    AdminUser?       @relation(fields: [createdById], references: [id])
  createdAt    DateTime         @default(now())

  @@map("customer_interactions")
}
