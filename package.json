{
  "name": "hemayatgar-insurance",
  "private": true,
  "version": "0.1.0",
  "description": "وب‌سایت اختصاصی نمایندگی بیمه ایران - شرکت خدمات بیمه‌ای حمایتگر (کد نمایندگی 9968)",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean",
    "db:generate": "pnpm --filter @hemayatgar/database prisma generate",
    "db:migrate": "pnpm --filter @hemayatgar/database prisma migrate dev",
    "db:studio": "pnpm --filter @hemayatgar/database prisma studio",
    "prepare": "husky"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "prettier": "^3.3.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": ["prettier --write"]
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.0.0"
  }
}
